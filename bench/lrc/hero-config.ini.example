; hero.ahk config template. Copy to hero-config.ini and fill in the [indicator]/[crop]/[zoom]
; screen coordinates during the calibration step in README.md -- they depend on this machine's
; actual LRC window layout and are NOT portable across machines/resolutions.

[general]
; switch | crop | zoom | mixed
Interaction=switch
LrcWindowTitle=ahk_exe Lightroom.exe
PreStartDelayMs=500

[indicator]
; Top-left corner square, positioned somewhere run-hero.ps1's ROI crop excludes.
X=20
Y=20
Size=60
; For crop/zoom, ScriptedDrag flashes twice more (drag-start, drag-end) in addition to the
; mode-entry flash below -- 3 total edges per capture. whisker's rising_edges only registers a new
; edge once the signal has dropped back below threshold, so keep FlashMs comfortably shorter than
; the real gap between those flashes (mode-entry -> drag-start is ~400ms at default Steps/timing;
; too-large a FlashMs can merge two flashes into one edge and mis-scope which sample is which --
; the calibration dry-run's "events_detected == 3" check in README.md catches this).
FlashMs=80

[switch]
ImageCount=50
; Must comfortably exceed the settle window whisker will look for after each keypress --
; err on the high side for the first calibration pass, tighten once you've seen real settle times.
InterKeyDelayMs=700

[crop]
; Corner-handle drag start/end screen coordinates in the crop overlay. hero.ahk acts on whatever
; image is currently open in LRC -- it does NOT navigate between images. hero-scenario.md's "5
; different images per run" spread for interactions B/C is done manually: navigate to each target
; image in LRC yourself, then invoke run-hero.ps1 once per image (5 separate runs/output folders).
StartX=0
StartY=0
EndX=0
EndY=0
DurationMs=2000
Steps=60
ExitCropAfter=1
; Undo (Ctrl+Z) the crop after ExitCropAfter commits it, so every repeat run on this image starts
; from the same uncropped state -- without this, run 2+ would drag against an already-cropped
; frame and silently invalidate both the crop geometry and the measurement.
RevertCropAfter=1

[zoom]
PanStartX=0
PanStartY=0
PanEndX=0
PanEndY=0
DurationMs=2000
Steps=60
; Time to let the 1:1 zoom settle before the pan drag starts, so the pan-frame-interval
; measurement isn't contaminated by the zoom-settle transition.
SettleWaitMs=1000

[mixed]
; Interaction D (#100): an interleaved sequence of step tokens, run `Repeats` times, driving each
; step's own events (see hero.ahk's mixed branch and hero-scenario.md's interaction D). Steps:
; switch (Right arrow), crop (r + a scripted drag using [crop]'s own coordinates + Enter),
; auto-tone (Ctrl+U), straighten (r + a click on the crop overlay's Auto-angle button + Enter).
; Every image the sequence visits must return to the synced edit stack afterward -- see
; RevertSettleMs below and README.md's mixed dry-run checklist.
Sequence=switch,crop,auto-tone,switch,straighten,switch,auto-tone,crop,straighten
Repeats=4
; Fixed cadence between steps -- NOT wait-for-settle. Waiting for a full settle before the next
; step would hide the very cross-operation regression #100 is measuring; an event that hasn't
; settled by the time the next step's flash fires is counted as "unsettled" by whisker, not
; silently dropped. Same rationale/default as [switch]'s InterKeyDelayMs.
StepGapMs=700
; Screen coordinates for the crop overlay's Auto-angle (auto-straighten) button, used by the
; `straighten` step -- calibrate alongside [crop]'s own coordinates (see README.md's Calibration
; section), with crop mode (`R`) already open.
StraightenAutoX=0
StraightenAutoY=0
; Time to let the trailing "end" flash's own transition settle before the undo pass begins.
RevertSettleMs=500
